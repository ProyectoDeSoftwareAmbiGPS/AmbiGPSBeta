{
  "info": {
    "name": "AmbiGPS - JWT y RBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "correo",
      "value": "usuario1@ambigps.com"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "jwt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login de USUARIO",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.unset(\"jwt\");",
              "if (pm.response.code === 200) {",
              "    const token = pm.response.json().token;",
              "    pm.test(\"JWT recibido\", () => pm.expect(token).to.be.a(\"string\"));",
              "    pm.collectionVariables.set(\"jwt\", token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Catalogo autorizado",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/tipos-material"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Catalogo sin token",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/tipos-material"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Administracion de roles denegada",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/roles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    }
  ]
}
